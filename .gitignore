__pycache__/
*.py[cod]
.venv/
venv/
env/
.env
config/local.yaml
logs/
*.log
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
_tmp_*
dist/
build/
*.egg-info/
*.rar
*.zip
data/
# outputs/: los CSV (64 MB) quedan fuera; los parquet + _meta.json sí se versionan
# porque son lo único que consume el tablero (`src/tablero/datos.py`) y permiten
# desplegarlo en Streamlit Community Cloud sin regenerar el modelo.
outputs/*
!outputs/_meta.json
!outputs/*.parquet
